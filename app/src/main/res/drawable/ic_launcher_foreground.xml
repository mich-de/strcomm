<?xml version="1.0" encoding="utf-8"?>
<!-- A rounded TV-screen frame with a play triangle inside, both in the app's amber accent —
     reads as "streaming on TV" at a glance and stays legible at launcher-icon sizes. Both shapes
     sit within the ~66dp adaptive-icon safe zone (roughly x:21-87, y:21-87 on this 108 canvas) so
     nothing gets clipped by a circular/squircle mask. Also used, unmodified, as the monochrome
     (Android 13+ themed-icon) layer — the system re-tints it from the alpha channel alone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFA726"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M32,28 L76,28 A8,8 0 0 1 84,36 L84,72 A8,8 0 0 1 76,80 L32,80 A8,8 0 0 1 24,72 L24,36 A8,8 0 0 1 32,28 Z" />
    <path
        android:fillColor="#FFA726"
        android:pathData="M46,42 L46,66 L68,54 Z" />
</vector>
